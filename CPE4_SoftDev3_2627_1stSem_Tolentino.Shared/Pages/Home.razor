<div style="display:flex;height:100vh;">

    <!-- LEFT SIDEBAR -->
    <div id="left-sidebar"
         style="
        width:@(_isSidebarCollapsed ? "40px" : "250px");
        background-color:#f0f0f0;
        display:flex;
        flex-direction:column;
        border-right:1px solid #ddd;
        overflow:hidden;
        transition:width 0.3s ease;">

        @if (_isSidebarCollapsed)
        {
            <!-- COLLAPSED SIDEBAR -->
            <div style="
                width:100%;
                padding-top:15px;
                display:flex;
                justify-content:center;
                align-items:flex-start;">

                <!-- SIDEBAR TOGGLE BUTTON -->
                <img src="_content/CPE4_SoftDev3_2627_1stSem_Tolentino.Shared/images/menu.svg"
                     @onclick="ToggleSidebar"
                     style="
                width:20px;
                height:20px;
                cursor:pointer;" />
            </div>
        }
        else
        {
            <!-- SIDEBAR HEADER -->
            <div style="
                padding:15px 20px;
                border-bottom:1px solid #ddd;
                display:flex;
                justify-content:space-between;
                align-items:center;">

                <!-- APP TITLE -->
                <h2 style="
                    color:#333;
                    font-size:22px;
                    font-weight:bold;
                    margin:0;">
                    Notes
                </h2>

                <!-- SIDEBAR TOGGLE BUTTON -->
                <img src="_content/CPE4_SoftDev3_2627_1stSem_Tolentino.Shared/images/menu.svg"
                     @onclick="ToggleSidebar"
                     style="
                width:20px;
                height:20px;
                cursor:pointer;" />
            </div>

            <!-- SIDEBAR CONTENT -->
            <div style="
                flex:1;
                padding:20px;
                overflow-y:auto;">

                <p style="
                    color:#666;
                    font-size:14px;
                    margin:0;">
                    LeftSidebar
                </p>

            </div>

            <!-- USER SECTION -->
            <div style="
                padding:20px;
                border-top:1px solid #ddd;
                display:flex;
                flex-direction:column;
                align-items:center;
                justify-content:center;
                text-align:center;">

                <!-- USERNAME -->
                <p style="
                    color:#198754;
                    font-size:14px;
                    margin:0 0 15px 0;
                    font-weight:700;">
                    @_name
                </p>

                <!-- LOGOUT BUTTON -->
                <button type="button"
                        @onclick="Logout"
                        style="
                    background-color:#e74c3c;
                    color:white;
                    border:none;
                    padding:8px 16px;
                    border-radius:4px;
                    font-weight:bold;
                    cursor:pointer;
                    font-size:13px;
                    width:80px;">
                    Logout
                </button>

            </div>
        }

    </div>

    <!-- MAIN CONTENT AREA -->
    <div id="main-content"
         style="
        flex:1;
        display:flex;
        flex-direction:column;
        height:100vh;">

        <!-- PAGE HEADER -->
        <div style="
            background-color:#ffffff;
            padding:15px 20px;">

            <!-- PAGE TITLE -->
            <h3 style="
                margin:0;
                color:#333;
                font-size:16px;
                font-weight:bold;">
                NoteEditor
            </h3>

        </div>

        <!-- PAGE BODY -->
        <div id="body"
             style="
            flex:1;
            padding:30px;
            overflow-y:auto;
            background-color:white;">
        </div>

    </div>

</div>

@* <h1>Hello, @_name!</h1>

Welcome to your new app running on <em>@factor</em> using <em>@platform</em>. *@

@code {

    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; }

    private string _name = "No Identity";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        _name = authState.User.Identity?.Name ?? "No Identity";
    }

    private bool _isSidebarCollapsed = false;

    private void ToggleSidebar()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
    }

    private void Logout() =>
        NavigationManager.NavigateTo("/logout", replace: true, forceLoad: true);
}
